<?xml version='1.0' encoding='utf-8'?>
<!--
  Maxwell HA (jgroups-raft) cluster configuration.  See docs/docs/high_availability.md.

  Every node must authenticate and encrypt cluster traffic: the raft role decides
  which node runs replication, so an unauthenticated member could hold leadership
  or force repeated elections.  This stack therefore:

    * uses TCP with a static TCPPING member list (no UDP multicast discovery),
    * encrypts all cluster messages with a shared AES key (SYM_ENCRYPT), and
    * requires a shared secret on JOIN (AUTH).

  Values are read from JVM system properties (e.g. JAVA_OPTS="-Djgroups.bind_addr=...")
  or environment variables of the same name.  The keystore password and auth
  secret have no defaults: a node without them fails to start instead of joining
  insecurely.  Keep the HA cluster on an isolated network segment as well.
-->
<config xmlns="urn:org:jgroups"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups.xsd">
    <TCP bind_addr="${jgroups.bind_addr:127.0.0.1}"
         bind_port="${jgroups.bind_port:7800}"
         port_range="0"/>
    <TCPPING initial_hosts="${jgroups.tcpping.initial_hosts:127.0.0.1[7800],127.0.0.1[7801],127.0.0.1[7802]}"
             port_range="0"/>
    <MERGE3 />
    <FD_SOCK/>
    <FD_ALL/>
    <VERIFY_SUSPECT timeout="1500"/>
    <SYM_ENCRYPT sym_algorithm="AES"
                 keystore_name="${jgroups.encrypt.keystore:raft.keystore}"
                 keystore_type="${jgroups.encrypt.keystore_type:PKCS12}"
                 store_password="${jgroups.encrypt.keystore_password}"
                 key_password="${jgroups.encrypt.keystore_password}"
                 alias="${jgroups.encrypt.alias:maxwell-ha}"/>
    <pbcast.NAKACK2 xmit_interval="500"/>
    <UNICAST3 xmit_interval="500"/>
    <pbcast.STABLE desired_avg_gossip="50000" max_bytes="4M"/>
    <raft.NO_DUPES/>
    <AUTH auth_class="org.jgroups.auth.MD5Token"
          auth_value="${jgroups.auth.secret}"
          token_hash="SHA"/>
    <pbcast.GMS print_local_addr="true" join_timeout="2000"/>
    <UFC max_credits="2M" min_threshold="0.4"/>
    <MFC max_credits="2M" min_threshold="0.4"/>
    <FRAG2 frag_size="60K"/>
    <raft.ELECTION election_min_interval="500" election_max_interval="1000" heartbeat_interval="250"/>
    <raft.RAFT members="A,B,C" raft_id="${raft_id:undefined}"/>
    <raft.REDIRECT/>
</config>
